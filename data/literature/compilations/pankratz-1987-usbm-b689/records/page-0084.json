      "$$",
      "\\begin{array}{r l} 2 9 8. 1 5 - 9 0 0 \\mathrm{K}: & \\mathrm{Cp} ^ {\\circ} = 3 6. 6 0 1 + 1 9. 7 2 4 \\times 1 0 ^ {- 3} \\mathrm{T} - 3. 2 1 1 \\times 1 0 ^ {5} \\mathrm{T} ^ {- 2} \\\\ & \\mathrm{H} ^ {\\circ} - \\mathrm{H} _ {2 9 8} ^ {\\circ} = 3 6. 6 0 1 \\times 1 0 ^ {- 3} \\mathrm{T} + 9. 8 6 2 \\times 1 0 ^ {- 6} \\mathrm{T} ^ {2} + 3. 2 1 1 \\times 1 0 ^ {2} \\mathrm{T} ^ {- 1} - 1 2. 8 6 6 \\end{array}",

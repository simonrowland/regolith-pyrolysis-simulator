      "\\begin{array}{l} 2 9 8. 1 5 - 2 0 0 0 \\mathrm{K}: \\quad \\mathrm{Cp} ^ {\\circ} = 1 7. 4 1 7 + 1. 6 1 4 \\times 1 0 ^ {- 3} \\mathrm{T} - 0. 9 7 6 \\times 1 0 ^ {5} \\mathrm{T} ^ {- 2} \\\\ \\mathrm{H} ^ {\\circ} - \\mathrm{H} _ {2 9 8} ^ {\\circ} = 1 7. 4 1 7 \\times 1 0 ^ {- 3} \\mathrm{T} + 0. 8 0 7 \\times 1 0 ^ {- 6} \\mathrm{T} ^ {2} + 0. 9 7 6 \\times 1 0 ^ {2} \\mathrm{T} ^ {- 1} - 5. 5 9 2 \\\\ \\end{array}",

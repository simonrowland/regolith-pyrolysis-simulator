+def test_mg012_refused_above_form_i_transition():
+    """Mg-012 I <-> II at 903 K: form II/III rows must not score as clino."""
+    assert refuse_janaf_temperature('Mg-012', 500.0, context='t') is None
+    assert refuse_janaf_temperature('Mg-008', 1000.0, context='t') is None
+    refusal = refuse_janaf_temperature('Mg-012', 1000.0, context='t')
+    assert refusal is not None
+    assert refusal.reason == JANAF_POLYMORPH_TRANSITION
+    assert 'form II' in refusal.detail
+    refusal_iii = refuse_janaf_temperature('Mg-012', 1500.0, context='t')
+    assert refusal_iii is not None and 'form III' in refusal_iii.detail
+    # Boundary: transition temperature itself is not form I.
+    assert refuse_janaf_temperature(
+        'Mg-012', MG012_FORM_I_MAX_K, context='t'
+    ).reason == JANAF_POLYMORPH_TRANSITION
+

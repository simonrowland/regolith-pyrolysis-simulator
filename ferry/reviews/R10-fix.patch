+# JANAF Mg-012 (MgSiO3 cr) is a multi-form table: printed I <-> II at 903 K
+# and II <-> III at 1258 K (parse_ambiguities on the compilation).  Form I
+# is the low-T clinoenstatite assessment the consumer pairs with TE cEn;
+# above 903 K the printed row is a different solid form.  Scoring cEn
+# (or any single polymorph label) across that boundary is a fake residual.
+MG012_FORM_I_MAX_K = 903.0  # I <-> II (exclusive upper bound for form I)
+MG012_FORM_II_MAX_K = 1258.0  # II <-> III
+
 # ThermoEngine quartz includes the upstream MELTS quartz correction:
 # QUARTZ_ADJUSTMENT = -1291.0 J/mol (ThermoEngine src/
 # BermanStoichiometricPhases.m:14, added to quartz enthalpy -- and through
@@ -298,6 +307,38 @@ def require_polymorph_match(
         )
 
 
+def refuse_janaf_temperature(
+    table_id: str, temperature_K: float, *, context: str
+) -> Optional[RefusalRow]:
+    """Refuse typed when the printed JANAF row is past a solid-solid split.
+
+    Mg-012 form I (clinoenstatite pairing) holds only below the I <-> II
+    transition at 903 K.  Rows at 1000 K / 1500 K are form II / III; the
+    static ``clinoenstatite`` stamp would manufacture a fake residual.
+    """
+
+    if table_id == 'Mg-012' and float(temperature_K) >= MG012_FORM_I_MAX_K:
+        form = (
+            'III'
+            if float(temperature_K) >= MG012_FORM_II_MAX_K
+            else 'II'
+        )
+        return RefusalRow(
+            reason=JANAF_POLYMORPH_TRANSITION,
+            detail=(
+                f'{context}: JANAF table Mg-012 at {temperature_K} K is '
+                f'solid form {form} (I <-> II at {MG012_FORM_I_MAX_K:g} K, '
+                f'II <-> III at {MG012_FORM_II_MAX_K:g} K); the consumer '
+                f'pairs only form I with clinoenstatite -- refusing rather '
+                f'than scoring a cross-form residual'
+            ),
+            janaf_table_id=table_id,
+            temperature_K=float(temperature_K),
+            janaf_polymorph=JANAF_TABLES[table_id].polymorph,
+        )
+    return None
+
+
